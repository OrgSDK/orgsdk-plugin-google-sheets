{
	"name": "@orgsdk/plugin-google-sheets",
	"version": "1.0.5",
	"description": "Google Sheets read/write + owns the shared google-oauth connect flow for google-sheets and google-tasks (first-party one-click or BYO)",
	"type": "module",
	"private": true,
	"scripts": {
		"check": "biome check .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"validate": "orgsdk-plugin validate",
		"package": "orgsdk-plugin package",
		"version-guard": "orgsdk-plugin version-guard",
		"build": "bun run typecheck && bun run validate && bun run package",
		"publish:catalog": "orgsdk-plugin publish",
		"build:npm": "node scripts/build-npm.mjs",
		"test:executor": "node scripts/test-executor.mjs",
		"pack:npm": "npm pack ./dist/npm --ignore-scripts",
		"test:registration": "node scripts/test-registration.mjs"
	},
	"dependencies": {
		"@googleapis/sheets": "18.1.2",
		"google-auth-library": "11.3.2",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.12",
		"@orgsdk/plugins": "0.2.2",
		"@types/bun": "^1.3.9",
		"typescript": "~6.0.3",
		"@orgsdk/executor": "0.1.0",
		"nock": "15.0.5"
	},
	"overrides": {
		"zod": "4.6.7",
		"qs": "6.17.1"
	},
	"patchedDependencies": {
		"@orgsdk/executor@0.1.0": "patches/@orgsdk%2Fexecutor@0.1.0.patch"
	},
	"license": "Apache-2.0",
	"author": "OrgSDK",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/OrgSDK/orgsdk-plugin-google-sheets.git"
	},
	"bugs": {
		"url": "https://github.com/OrgSDK/orgsdk-plugin-google-sheets/issues"
	},
	"homepage": "https://github.com/OrgSDK/orgsdk-plugin-google-sheets#readme"
}
